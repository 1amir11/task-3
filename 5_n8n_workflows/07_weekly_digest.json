{
  "name": "Cottonil - Weekly digest (Monday)",
  "nodes": [
    {
      "id": "77c671c5-e7d0-43b9-9095-6df6b7b58931",
      "name": "Run now (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "cottonil-digest",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "webhookId": "557a71e6-ad6c-4d6d-a972-f82b6c52421f"
    },
    {
      "id": "01638fb0-aa96-4004-9593-9de292150025",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The only place to configure this workflow.\nconst TELEGRAM_CHAT_ID = '';  // put your Telegram chat ID here   // management group chat ID. Empty = log only, no message.\nconst j = $input.first().json;\nconst fromWebhook = !!j.headers;\nconst body = j.body || {};\nconst asked = body.source || '';\nconst weekEnd = /^\\d{4}-\\d{2}-\\d{2}$/.test(String(body.week_end || '')) ? body.week_end : null;\nreturn [{ json: {\n  source: fromWebhook ? (['dashboard', 'manual'].includes(asked) ? asked : 'api') : 'schedule',\n  from_webhook: fromWebhook,\n  chat_id: String(TELEGRAM_CHAT_ID).trim(),\n  week_end: fromWebhook ? weekEnd : null\n} }];"
      }
    },
    {
      "id": "4031210a-f61b-48a9-8c97-95a6c72f10c8",
      "name": "Get week numbers (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        480,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ebnoaswhrmhlmxvmfsxl.supabase.co/rest/v1/rpc/weekly_digest",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_week_end: $json.week_end }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "credentials": {
        "supabaseApi": {
          "id": "ewxz5r0M7n7dsfgZ",
          "name": "Cottonil"
        }
      }
    },
    {
      "id": "211a88fd-4544-4c9a-8f0b-b4a2a644aa75",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Every value comes from weekly_digest(); this node only formats them and computes the deltas.\nconst d = $input.first().json;\nconst cfg = $('Config').first().json;\nconst k = d.kpis || {};\nconst t = k.this_week || {}, p = k.prev_week || {}, y = k.last_year || {};\nconst nf = n => Number(n || 0).toLocaleString('en-US', { maximumFractionDigits: 0 });\nconst pct = (a, b) => (b ? ((a - b) / b * 100) : null);\nconst sgn = v => v === null ? 'n/a' : (v >= 0 ? '+' : '') + v.toFixed(1) + '%';\nconst pp = (a, b) => (b === undefined || b === null) ? 'n/a' : ((a - b) >= 0 ? '+' : '') + (a - b).toFixed(2) + ' pp';\nconst g = d.guardrail || {}, r = d.reactivation_last_run || null, a = d.assistant_7d || {};\nconst line = (label, val, unit, cur, prev, ly) => label + ': ' + val + unit + '  (أسبوع: ' + sgn(pct(cur, prev)) + ' | سنة: ' + sgn(pct(cur, ly)) + ')';\nconst text = '📊 ملخص أسبوع كوتونيل — ' + d.week.from + ' → ' + d.week.to + '\\n\\n'\n  + line('المبيعات الصافية', nf(t.net_egp), ' جنيه', t.net_egp, p.net_egp, y.net_egp) + '\\n'\n  + line('الأوردرات', nf(t.orders), '', t.orders, p.orders, y.orders) + '\\n'\n  + line('متوسط الأوردر', nf(t.aov_egp), ' جنيه', t.aov_egp, p.aov_egp, y.aov_egp) + '\\n'\n  + line('المشترين', nf(t.buyers), '', t.buyers, p.buyers, y.buyers) + '\\n'\n  + 'هامش الربح: ' + t.gm_pct + '%  (أسبوع: ' + pp(t.gm_pct, p.gm_pct) + ' | سنة: ' + pp(t.gm_pct, y.gm_pct) + ')\\n'\n  + 'نسبة الخصم: ' + t.discount_pct + '%  (أسبوع: ' + pp(t.discount_pct, p.discount_pct) + ' | سنة: ' + pp(t.discount_pct, y.discount_pct) + ')\\n\\n'\n  + '🚨 الخصومات: ' + nf(g.lines_above_15pct) + ' سطر بخصم أكتر من 15%، ' + nf(g.excess_egp) + ' جنيه خصم فوق سقف 10%.\\n'\n  + (r ? '🔁 حملة الاسترجاع (#' + r.run_id + '): ' + r.status + ' — ' + nf(r.treatment) + ' عميل + ' + nf(r.holdout) + ' holdout.\\n' : '🔁 حملة الاسترجاع: مفيش run لسه.\\n')\n  + '🤖 المساعد (7 أيام): ' + nf(a.questions) + ' سؤال، ' + nf(a.answered) + ' اتجاوب، ' + nf(a.refused) + ' اترفض (خصوصية/خارج النطاق)، ' + nf(a.errors) + ' error، grounded ' + (a.grounded_pct ?? 'n/a') + '%.\\n\\n'\n  + 'ملحوظة: الداتا synthetic للتدريب، مش أرقام مراجَعة.';\nconst summary = 'Week ' + d.week.from + '..' + d.week.to + ': net ' + nf(t.net_egp) + ' EGP (' + sgn(pct(t.net_egp, p.net_egp)) + ' WoW, '\n  + sgn(pct(t.net_egp, y.net_egp)) + ' YoY), ' + nf(t.orders) + ' orders, GM ' + t.gm_pct + '%. Discounts: ' + nf(g.lines_above_15pct)\n  + ' lines above 15%, ' + nf(g.excess_egp) + ' EGP above a 10% cap. Assistant: ' + nf(a.questions) + ' questions, grounded ' + (a.grounded_pct ?? 'n/a') + '%.';\nreturn [{ json: {\n  summary, text,\n  send_telegram: cfg.chat_id !== '',\n  log_row: { workflow: 'digest', source: cfg.source, status: 'ok', data_day: d.week.to, summary, payload: d },\n  response: { status: 'ok', summary, text, week: d.week, telegram: cfg.chat_id !== '' }\n} }];"
      }
    },
