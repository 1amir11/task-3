        0,
        208
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ebnoaswhrmhlmxvmfsxl.supabase.co/rest/v1/rpc/kb_pending",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "cc582ee3-2a88-4d1b-957b-94964a3bef67",
      "name": "Fetch new or changed chunks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        272,
        304
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "ewxz5r0M7n7dsfgZ",
          "name": "Cottonil"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Incremental ingestion: only chunks with no embedding or whose content hash changed come in.\n// Batching 16 texts per call = 3 API calls for 46 chunks instead of 46.\nconst chunks = $input.all().map(i => i.json).filter(c => c && c.id != null && c.text);\nconst SIZE = 16;\nconst batches = [];\nfor (let i = 0; i < chunks.length; i += SIZE) {\n  const part = chunks.slice(i, i + SIZE);\n  batches.push({ json: {\n    batch_no: batches.length + 1,\n    ids: part.map(c => c.id),\n    hashes: part.map(c => c.content_hash),\n    texts: part.map(c => c.text.slice(0, 8000))\n  } });\n}\nif (!batches.length) return [{ json: { nothing_to_do: true, pending: 0 } }];\nreturn batches.map(b => ({ json: { ...b.json, nothing_to_do: false, pending: chunks.length } }));"
      },
      "id": "dc9674a9-baa3-48e5-9a1f-db0c03f05759",
      "name": "Plan batches of 16",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.nothing_to_do }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "4a9fa7bb-e8fc-4b4e-92fc-3010146a75d0",
      "name": "Anything to embed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        768,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"openai/text-embedding-3-small\", input: $json.texts }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 500
            }
          },
          "timeout": 60000
        }
      },
      "id": "e02584b9-6133-4020-9212-bc73af991e42",
      "name": "Embed batch (OpenRouter)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1008,
        208
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "openRouterApi": {
          "id": "VpUansl3XxDGcyJI",
          "name": "Cottonil"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Quality gate: never write a broken vector. Wrong count or wrong dimension = fail the run loudly.\nconst DIMS = 1536;\nconst batches = $('Plan batches of 16').all();\nconst out = [];\n$input.all().forEach((item, b) => {\n  const plan = batches[b].json;\n  const data = (item.json.data || []).slice().sort((x, y) => x.index - y.index);\n  if (data.length !== plan.ids.length) {\n    throw new Error('Batch ' + plan.batch_no + ': sent ' + plan.ids.length + ' texts, got ' + data.length + ' vectors. ' + JSON.stringify(item.json.error || '').slice(0, 300));\n  }\n  data.forEach((d, i) => {\n    if (!Array.isArray(d.embedding) || d.embedding.length !== DIMS) {\n      throw new Error('Chunk ' + plan.ids[i] + ': expected ' + DIMS + ' dims, got ' + (d.embedding || []).length);\n    }\n    out.push({ json: {\n      p_id: plan.ids[i],\n      p_embedding: '[' + d.embedding.join(',') + ']',\n      p_model: item.json.model || 'openai/text-embedding-3-small',\n      p_hash: plan.hashes[i]\n    } });\n  });\n});\nreturn out;"
      },
      "id": "046e60aa-3510-42f0-abec-156f66a8d443",
      "name": "Validate vectors",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        208
      ]
    },
    {
      "parameters": {
        "method": "POST",
