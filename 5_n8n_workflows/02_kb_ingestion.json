    {
      "parameters": {
        "method": "POST",
        "url": "https://ebnoaswhrmhlmxvmfsxl.supabase.co/rest/v1/rpc/kb_coverage",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {}
      },
      "id": "804dcdea-c7d6-4be1-8a61-a43b36cdc79f",
      "name": "Check coverage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1728,
        320
      ],
      "executeOnce": true,
      "credentials": {
        "supabaseApi": {
          "id": "ewxz5r0M7n7dsfgZ",
          "name": "Cottonil"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const c = $input.first().json;\nlet saved = 0, failed = [];\ntry {\n  $('Save embedding (Supabase)').all().forEach(i => i.json.ok ? saved++ : failed.push(i.json.id));\n} catch (e) { /* branch did not run: nothing was pending */ }\nconst report = {\n  kb_total: c.total, kb_embedded: c.embedded, kb_missing: c.missing, kb_stale: c.stale,\n  coverage_pct: c.total ? Math.round(1000 * c.embedded / c.total) / 10 : 0,\n  saved_this_run: saved, failed_ids: failed, models: c.models,\n  healthy: c.missing === 0 && c.stale === 0 && failed.length === 0\n};\nif (!report.healthy) throw new Error('KB not fully embedded: ' + JSON.stringify(report));\nreturn [{ json: report }];"
      },
      "id": "154aa55b-8acf-4e52-9209-c29d75127b3a",
      "name": "Run report",
